# Configuración del Transcriptor. Copia este fichero a ".env" y cambia lo que quieras:
#     cp .env.example .env
# Formato: CLAVE=valor, sin comillas y con los comentarios en su propia línea (como estos).
# Lo que escribas en la línea de comandos (make up PORT=4748) manda sobre este fichero.

# --- Audios de WhatsApp de escritorio (solo macOS; ver el README) ---
# Qué chats se copian solos a la carpeta de entrada:
#   all            todos los chats
#   <id>,<id>      solo esos chats (el id lo muestra `make whatsapp`; tu chat contigo mismo, por ejemplo)
#   (vacío)        los chats elegidos con `make whatsapp`
# WHATSAPP_CHATS=all
# Al encender, también se procesan los audios de los últimos N minutos (0 = solo los que lleguen después):
# WHATSAPP_BACKLOG_MIN=60

# --- General (opcional) ---
# PORT=4747
# RETENTION_DAYS=1
# OLLAMA_MODEL=qwen2.5:7b
# WHISPER_MODEL_FILE=ggml-large-v3.bin
# WHISPER_THREADS=4
# DATA_PATH=/Users/tu-usuario/TranscriptorAudios
# INBOX_PATH=/Users/tu-usuario/TranscriptorAudios/entrada
