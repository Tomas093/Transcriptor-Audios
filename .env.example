# Configuración del Transcriptor. Copia este fichero a ".env" y cambia lo que quieras:
#     cp .env.example .env
# Formato: CLAVE=valor, sin comillas y con los comentarios en su propia línea (como estos).
# Lo que escribas en la línea de comandos (make up PORT=4748) manda sobre este fichero.

# --- Audios de WhatsApp y segundo plano ---
# Valores por defecto. Lo que guardes en la web (botón Configuración) manda sobre esto.
# Qué chats se copian solos a la carpeta de entrada:
#   all            todos los chats
#   <id>,<id>      solo esos chats (el id lo muestra la web: Configuración → Detectar chat)
#   (vacío)        ninguno
# WHATSAPP_CHATS=
# Al encender o cambiar la configuración, también los audios de los últimos N minutos (0 = solo los nuevos):
# WHATSAPP_BACKLOG_MIN=60
# Escuchar en segundo plano (necesita `make agente` o `.\transcriptor.cmd agente`): 1 = sí
# BACKGROUND_ENABLED=0
# Apagar todo tras N minutos sin actividad:
# BACKGROUND_IDLE_MIN=10
# Al apagar, cerrar también Docker Desktop si lo abrió el agente (y no hay otros contenedores): 1 = sí
# BACKGROUND_QUIT_DOCKER=0
# Solo Windows: carpeta donde WhatsApp guarda los audios, si no la encuentra solo
# (ver `.\transcriptor.cmd whatsapp-diagnostico`):
# WHATSAPP_MEDIA=C:\Users\tu-usuario\AppData\Local\Packages\...\LocalState\shared\transfers

# --- General (opcional) ---
# PORT=4747
# RETENTION_DAYS=1
# OLLAMA_MODEL=qwen2.5:7b
# WHISPER_MODEL_FILE=ggml-large-v3.bin
# WHISPER_THREADS=4
# DATA_PATH=/Users/tu-usuario/TranscriptorAudios
# INBOX_PATH=/Users/tu-usuario/TranscriptorAudios/entrada
